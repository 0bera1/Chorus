# --- Backend (apps/api) ---
PORT=4000
DATABASE_URL=postgres://chorus:chorus@localhost:5432/chorus
# Comma-separated list of origins allowed for CORS and Socket.IO
CORS_ORIGINS=http://localhost:3000
# Hash secret for host keys and participant tokens (use a long random value)
TOKEN_SECRET=change-me-to-a-long-random-string
# Rooms with no activity for this many hours are closed and purged from memory
ROOM_IDLE_HOURS=6
# Max participants per room
ROOM_MAX_PARTICIPANTS=500

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
